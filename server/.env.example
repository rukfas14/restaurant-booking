PORT=4000
JWT_SECRET=your_jwt_secret_here

# SQLite database file
DB_PATH=./data/booking.db

# --- Email (Resend — Railway blocks SMTP, so we use HTTPS) ---
# Get an API key at https://resend.com/api-keys
# Leave RESEND_API_KEY blank in dev — emails will be skipped & logged.
RESEND_API_KEY=re_your_api_key_here

# "From" address. Resend ships a sandbox sender that works without
# domain verification — fine for testing. For production, verify your
# domain in Resend and use e.g. "Margherita <rezervacije@yourdomain.ba>".
RESEND_FROM=Booking <onboarding@resend.dev>

# Where the "Nova rezervacija" notification goes.
ADMIN_EMAIL=your@gmail.com

# Restaurant defaults (used as fallback in seed + email templates)
RESTAURANT_NAME=Restoran Stari Grad
RESTAURANT_PHONE=+387 33 555 000

# Comma-separated list of allowed browser origins for CORS.
# Empty or "*" allows all origins. localhost:8080 + localhost:5173
# are always allowed in dev.
CLIENT_ORIGIN=
