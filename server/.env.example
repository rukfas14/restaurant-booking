PORT=4000
JWT_SECRET=your_jwt_secret_here

# SQLite database file
DB_PATH=./data/booking.db

# Gmail SMTP (leave blank in dev — emails fall back to console)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your@gmail.com
SMTP_PASS=your_app_password
SMTP_FROM="Restoran Stari Grad <your@gmail.com>"
ADMIN_EMAIL=your@gmail.com

# Restaurant defaults (used as fallback in seed + emails)
RESTAURANT_NAME=Restoran Stari Grad
RESTAURANT_PHONE=+387 33 555 000

# Comma-separated list of allowed browser origins for CORS.
# http://localhost:8080 (the website) is always allowed in dev.
CLIENT_ORIGIN=http://localhost:5173
